<% layout("/layouts/boilerplate.ejs") %>

<main class="page-container">
  <a class="back-link" href="/posts/<%= post.id %>">
    <i class="fa-solid fa-arrow-left"></i> Cancel and go back
  </a>

  <section class="form-card">
    <p class="eyebrow">Edit post</p>
    <h1>Update your thoughts</h1>
    <p class="subtitle">Editing as <strong>@<%= post.username %></strong></p>

    <form method="post" action="/posts/<%= post.id %>?_method=PATCH">
      <label for="content">Your post</label>

      <textarea id="content" name="content" required><%= post.content %></textarea>

      <div class="form-actions">
        <a class="cancel-btn" href="/posts/<%= post.id %>">Cancel</a>
        <button class="create-btn" type="submit">
          <i class="fa-solid fa-check"></i> Save changes
        </button>
      </div>
    </form>
  </section>
</main>