<% layout("/layouts/boilerplate.ejs") %>

<main class="page-container">
  <header class="page-header">
    <div>
      <p class="eyebrow">Community conversations</p>
      <h1>Quora Posts</h1>
      <p class="subtitle">Share ideas, ask questions, and join the discussion.</p>
    </div>

    <a class="create-btn" href="/posts/new">
      <i class="fa-solid fa-plus"></i> Create post
    </a>
  </header>

  <section class="posts-grid">
    <% for (const post of posts) { %>
      <article class="post-card">
        <div class="avatar">
          <%= post.username.charAt(0).toUpperCase() %>
        </div>

        <div class="post-body">
          <h2>@<%= post.username %></h2>
          <p><%= post.content %></p>

          <div class="post-actions">
            <a class="details-btn" href="/posts/<%= post.id %>">
              <i class="fa-regular fa-eye"></i> Details
            </a>

            <a class="edit-btn" href="/posts/<%= post.id %>/edit">
              <i class="fa-regular fa-pen-to-square"></i> Edit
            </a>

            <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
              <button class="delete-btn" type="submit">
                <i class="fa-regular fa-trash-can"></i> Delete
              </button>
            </form>
          </div>
        </div>
      </article>
    <% } %>
  </section>
</main>


