<% layout("/layouts/boilerplate.ejs") %>

<main class="page-container">
  <a class="back-link" href="/posts">
    <i class="fa-solid fa-arrow-left"></i> Back to posts
  </a>

  <article class="detail-card">
    <div class="detail-top">
      <div class="avatar large-avatar">
        <%= post.username.charAt(0).toUpperCase() %>
      </div>

      <div>
        <p class="eyebrow">Post details</p>
        <h1>@<%= post.username %></h1>
      </div>
    </div>

    <p class="detail-content"><%= post.content %></p>

    <div class="post-actions">
      <a class="edit-btn" href="/posts/<%= post.id %>/edit">
        <i class="fa-regular fa-pen-to-square"></i> Edit post
      </a>

      <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
        <button class="delete-btn" type="submit">
          <i class="fa-regular fa-trash-can"></i> Delete post
        </button>
      </form>
    </div>
  </article>
</main>

